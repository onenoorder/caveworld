{
  "name": "es-cw-frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^11.2.7",
    "@testing-library/user-event": "^12.8.3",
    "@types/jest": "^26.0.24",
    "@types/node": "^24.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.3.1",
    "react-app-rewire-alias": "^1.1.7",
    "react-app-rewired": "^2.2.1",
    "react-dom": "^18.3.1",
    "react-scripts": "^5.0.1",
    "three": "^0.169.0",
    "typescript": "^4.4.2",
    "web-vitals": "^1.1.2"
  },
  "scripts": {
    "start": "react-app-rewired --openssl-legacy-provider start",
    "build": "react-app-rewired build",
    "test": "react-app-rewired test --passWithNoTests",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
    "jest": {
    "testMatch": [
      "**/__tests__/**/*.{js,jsx,ts,tsx}",
      "**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    "collectCoverageFrom": [
      "src/World.tsx",
      "src/services/EntityService.tsx",
      "src/controls/Mouse.tsx"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 12,
        "functions": 18
      },
      "./src/World.tsx": {
        "lines": 100,
        "functions": 100
      },
      "./src/services/EntityService.tsx": {
        "lines": 100,
        "functions": 100
      },
      "./src/controls/Mouse.tsx": {
        "lines": 100,
        "functions": 100
      }
    },
    "moduleNameMapper": {
      "^_controls/(.*)$": "<rootDir>/src/controls/$1",
      "^_utilities/(.*)$": "<rootDir>/src/utilities/$1",
      "^_services/(.*)$": "<rootDir>/src/services/$1",
      "^_entities/(.*)$": "<rootDir>/src/entities/$1",
      "^_buildings/(.*)$": "<rootDir>/src/entities/buildings/$1",
      "^_houses/(.*)$": "<rootDir>/src/entities/buildings/houses/$1",
      "^_storages/(.*)$": "<rootDir>/src/entities/buildings/storages/$1",
      "^_dwarfs/(.*)$": "<rootDir>/src/entities/dwarfs/$1",
      "^_constructions/(.*)$": "<rootDir>/src/entities/constructions/$1",
      "^_jobs/(.*)$": "<rootDir>/src/jobs/$1",
      "^_tasks/(.*)$": "<rootDir>/src/tasks/$1",
      "^_factories/(.*)$": "<rootDir>/src/factories/$1",
      "^_behaviors/(.*)$": "<rootDir>/src/behaviors/$1",
      "^_goals/(.*)$": "<rootDir>/src/goals/$1"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/three": "^0.131.0"
  }
}
